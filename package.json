{
  "name": "absolute-cinema",
  "version": "1.0.0",
  "description": "Lista sessões legendadas dos cinemas monitorados e mantém o histórico de Três Lagoas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "sessions": "tsx src/index.ts",
    "legendado": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.worker.json",
    "dev:web": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply absolute-cinema-history --local",
    "db:migrate:remote": "wrangler d1 migrations apply absolute-cinema-history --remote",
    "deploy": "npm run check && wrangler deploy",
    "prepack": "npm run build"
  },
  "keywords": [
    "cinema",
    "ingresso",
    "legendado",
    "sessions"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
