// Configuração Cloudflare Wrangler v4+
// Front-end estático em web/ + worker (backend) responsável por /api/*
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tres-lagoas",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-22",
  "triggers": {
    // 09h, 12h, 15h, 18h e 21h no horário de Três Lagoas (MS, UTC-4).
    "crons": ["0 1,13,16,19,22 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "absolute-cinema-history",
      "database_id": "8a813507-45ce-4fb1-83cb-87b20ccb6d83",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./web",
    // O worker intercepta /api/*; tudo o mais é servido como estático
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Vazio: a API só é legível pelo próprio site (mesma origem).
    // Para liberar outra origem, ex.:
    // "ALLOWED_ORIGIN": "https://meu-outro-site.example"
    "ALLOWED_ORIGIN": ""
  }
}
